# Copy to .env.local and fill in. Never commit real values.

# Clerk (Dashboard → API keys / Webhooks)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Neon Postgres (pooled connection string)
DATABASE_URL=

# Trigger.dev (Dashboard → API keys, dev environment)
TRIGGER_SECRET_KEY=

# Anthropic (console.anthropic.com) — plan generation and meal analysis.
# Also add it to the Trigger.dev dashboard for deployed environments.
ANTHROPIC_API_KEY=
# Optional model overrides (default claude-haiku-5-5)
# PLAN_MODEL=
# MEAL_MODEL=

# ImageKit (Dashboard → Developer options) — private meal photos
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_SECRET_KEY=
IMAGEKIT_URL_ENDPOINT=
# Optional: folder prefix per environment (default dev)
# IMAGEKIT_ENV=dev

# Optional: max meal scans per user in 24 hours (default 20)
# MEAL_SCAN_DAILY_LIMIT=20
